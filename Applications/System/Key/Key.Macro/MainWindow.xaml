<Window x:Class="KeyMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KeyMacro.Views"
        Title="Key.Macro — 키 매크로" Height="760" Width="1120" MinHeight="620" MinWidth="940"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Malgun Gothic" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <v:OrdinalConverter x:Key="Ordinal"/>
        <v:EnumIndexConverter x:Key="EnumIndex"/>

        <!-- 목록 안에서 쓰는 작은 아이콘 버튼 -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="#9A9AB0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A50"/>
                                <Setter Property="Foreground" Value="#4DD0E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 목록 공통 (매크로 · 동작) -->
        <Style x:Key="CardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A3A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C3B45"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 섹션 제목 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════ 헤더 ══════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⌨" FontSize="22" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Key.Macro" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="키 하나를 누르면 지정한 클릭·입력이 순서대로 실행됩니다"
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BdStatus" Background="#2A2A38" CornerRadius="14" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotStatus" Width="9" Height="9" Fill="{StaticResource TextSecondary}"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="감시 꺼짐" Margin="8,0,0,0" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🕒  시간 동기화" Margin="0,0,6,0" Click="BtnTimeSync_Click"
                            ToolTip="기준 사이트 시각에 PC 시계를 맞춥니다 (예약 실행 정확도)"/>
                    <Button Content="⚙  설정" Margin="0,0,10,0" Click="BtnOptions_Click"
                            ToolTip="중단 키 등 전체 설정"/>
                    <Button x:Name="BtnToggle" Content="감시 시작" Style="{StaticResource AccentButton}"
                            MinWidth="118" Click="BtnToggle_Click"
                            ToolTip="켜면 등록된 트리거 키를 전역에서 감지합니다"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 본문 ══════════ -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 좌: 매크로 목록 ── -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtRuleCount" Text="매크로 0개" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="＋ 새 매크로" HorizontalAlignment="Right" Padding="10,5"
                                FontSize="12" Click="BtnAddRule_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="LstRules" Style="{StaticResource CardList}"
                                 ItemContainerStyle="{StaticResource CardItem}"
                                 SelectionChanged="LstRules_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Checked="RuleEnabled_Changed" Unchecked="RuleEnabled_Changed"
                                                  ToolTip="체크를 끄면 이 매크로는 동작하지 않습니다"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1A1A22" CornerRadius="5" Padding="8,3"
                                                        BorderBrush="{StaticResource AccentDim}" BorderThickness="1">
                                                    <TextBlock Text="{Binding TriggerDisplay}" FontFamily="Consolas"
                                                               FontSize="12" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" FontSize="13.5"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,5,0,0"
                                                       Foreground="#9A9AB0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="BtnDuplicate" Content="복제" Padding="12,5" FontSize="12"
                                Margin="0,0,6,0" Click="BtnDuplicate_Click"/>
                        <Button x:Name="BtnDeleteRule" Content="삭제" Padding="12,5" FontSize="12"
                                Foreground="{StaticResource DangerBrush}" Click="BtnDeleteRule_Click"/>
                        <Button Content="가져오기" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                                Click="BtnImport_Click" ToolTip="JSON 파일에서 매크로 불러오기"/>
                        <Button Content="내보내기" Padding="12,5" FontSize="12" Margin="6,0,0,0"
                                Click="BtnExport_Click" ToolTip="현재 매크로를 JSON 파일로 저장"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 우: 편집 ── -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <!-- 선택된 매크로가 없을 때 안내 -->
                <Border x:Name="PnlEmpty" Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⌨" FontSize="46" HorizontalAlignment="Center"
                                   Foreground="#3A3A50"/>
                        <TextBlock Text="왼쪽에서 매크로를 고르거나 새로 만드세요" FontSize="14" Margin="0,16,0,0"
                                   Foreground="{StaticResource TextSecondary}"/>
                        <Button Content="＋ 새 매크로 만들기" Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Center" Margin="0,18,0,0" Click="BtnAddRule_Click"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="PnlEditor" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>

                        <!-- ① 트리거 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="① 이 키를 누르면"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#1A1A22" CornerRadius="8" Padding="18,10"
                                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                            MinWidth="150">
                                        <TextBlock x:Name="TxtTrigger" Text="키 미지정" FontFamily="Consolas"
                                                   FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                    <Button Content="키 지정" Margin="10,0,0,0" VerticalAlignment="Stretch"
                                            Click="BtnSetTrigger_Click"
                                            ToolTip="누르면 키 입력을 직접 받아 트리거로 등록합니다"/>
                                    <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="매크로 이름" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtName" Width="240" TextChanged="TxtName_TextChanged"/>
                                    </StackPanel>
                                </StackPanel>
                                <CheckBox x:Name="ChkSuppress" Margin="0,14,0,0" Click="ChkSuppress_Click"
                                          Content="트리거 키의 원래 입력을 다른 프로그램에 전달하지 않음"
                                          ToolTip="예를 들어 숫자 1을 트리거로 쓰면, 눌러도 1이 입력되지 않습니다"/>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,8,0,0"
                                           Text="아래 ⑤ 예약 실행만 쓸 매크로라면 트리거 키를 비워 둬도 됩니다."/>
                            </StackPanel>
                        </Border>

                        <!-- ② 동작 시퀀스 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="0,10,0,0"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="② 이 동작들을 위에서 아래 순서로 실행합니다"/>

                                <Border Background="#1A1A22" CornerRadius="8" Padding="8" MinHeight="150">
                                    <Grid>
                                        <TextBlock x:Name="TxtNoAction" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12.5" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" TextAlignment="Center"
                                                   Text="아직 동작이 없습니다&#x0a;아래 버튼으로 마우스 클릭 지점이나 키 입력을 추가하세요"/>
                                        <ListBox x:Name="LstActions" Style="{StaticResource CardList}"
                                                 ItemContainerStyle="{StaticResource CardItem}"
                                                 AlternationCount="999" MaxHeight="264"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="False"
                                                 SelectionChanged="LstActions_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="10,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="22" Height="22"
                                                                    CornerRadius="11" Background="#33334A">
                                                                <TextBlock FontSize="11" FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           Text="{Binding (ItemsControl.AlternationIndex),
                                                                                  RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                                                  Converter={StaticResource Ordinal}}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Glyph}"
                                                                       FontSize="15" Margin="10,0,10,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Display}"
                                                                       FontSize="13.5" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                                <Button Content="▲" Style="{StaticResource MiniButton}"
                                                                        Tag="{Binding}" Click="BtnMoveUp_Click"
                                                                        ToolTip="위로"/>
                                                                <Button Content="▼" Style="{StaticResource MiniButton}"
                                                                        Tag="{Binding}" Click="BtnMoveDown_Click"
                                                                        ToolTip="아래로"/>
                                                                <Button Content="✕" Style="{StaticResource MiniButton}"
                                                                        Tag="{Binding}" Click="BtnRemoveAction_Click"
                                                                        ToolTip="삭제"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="🖱  마우스 클릭 추가" Style="{StaticResource AccentButton}"
                                            Margin="0,0,8,0" Click="BtnAddClick_Click"
                                            ToolTip="화면에서 클릭할 지점을 마우스로 직접 찍습니다"/>
                                    <Button Content="⌨  키 입력 추가" Margin="0,0,8,0" Click="BtnAddKey_Click"
                                            ToolTip="원하는 키를 직접 눌러 등록합니다"/>
                                    <Button Content="📝  텍스트 입력 추가" Margin="0,0,8,0" Click="BtnAddText_Click"/>
                                    <Button Content="⏱  대기 추가" Margin="0,0,8,0" Click="BtnAddDelay_Click"/>
                                    <Button Content="↖  커서 이동 추가" Click="BtnAddMove_Click"
                                            ToolTip="클릭 없이 커서만 옮깁니다"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ③ 선택한 동작 설정 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="0,10,0,0"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="③ 선택한 동작 설정"/>

                                <TextBlock x:Name="TxtNoSelection" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12.5" Text="위 목록에서 동작을 고르면 여기서 세부 값을 바꿀 수 있습니다"/>

                                <!-- 마우스 클릭 / 커서 이동 -->
                                <StackPanel x:Name="PnlMouse" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="좌표" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtPosX" Width="86" TextChanged="Pos_TextChanged"/>
                                        <TextBlock Text="," Margin="6,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtPosY" Width="86" TextChanged="Pos_TextChanged"/>
                                        <Button Content="🖱  화면에서 다시 찍기" Margin="10,0,0,0" Padding="12,5"
                                                FontSize="12" Click="BtnRepick_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PnlClickOnly" Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="버튼" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbButton" Width="118"
                                                  SelectionChanged="CmbButton_SelectionChanged">
                                            <ComboBoxItem Content="왼쪽 클릭"/>
                                            <ComboBoxItem Content="오른쪽 클릭"/>
                                            <ComboBoxItem Content="가운데 클릭"/>
                                        </ComboBox>
                                        <TextBlock Text="횟수" Style="{StaticResource FieldLabel}" Margin="18,0,8,0"/>
                                        <TextBox x:Name="TxtClickCount" Width="60" TextChanged="ClickCount_TextChanged"/>
                                        <TextBlock Text="회  (2회 = 더블클릭)" Style="{StaticResource FieldLabel}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 키 입력 -->
                                <StackPanel x:Name="PnlKey" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="키" Style="{StaticResource FieldLabel}"/>
                                        <Border Background="#1A1A22" CornerRadius="6" Padding="14,7"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                MinWidth="150">
                                            <TextBlock x:Name="TxtActionKey" FontFamily="Consolas" FontSize="14"
                                                       FontWeight="Bold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <Button Content="⌨  키 다시 누르기" Margin="10,0,0,0" Padding="12,5"
                                                FontSize="12" Click="BtnRecaptureKey_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="방식" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="CmbKeyMode" Width="170"
                                                  SelectionChanged="CmbKeyMode_SelectionChanged">
                                            <ComboBoxItem Content="누르고 떼기"/>
                                            <ComboBoxItem Content="누른 채로 두기"/>
                                            <ComboBoxItem Content="떼기"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource FieldLabel}" Margin="14,0,0,0"
                                                   Text="※ 누른 채로 두면 뒤에 '떼기' 동작을 꼭 넣어 주세요"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 텍스트 -->
                                <StackPanel x:Name="PnlText" Visibility="Collapsed">
                                    <TextBlock Text="입력할 내용 (한글·이모지 가능, 줄바꿈은 Enter 입력으로 처리)"
                                               Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtActionText" Height="78" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto" TextChanged="ActionText_TextChanged"/>
                                </StackPanel>

                                <!-- 대기 -->
                                <StackPanel x:Name="PnlDelay" Visibility="Collapsed" Orientation="Horizontal">
                                    <TextBlock Text="대기 시간" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtDelay" Width="90" TextChanged="Delay_TextChanged"/>
                                    <TextBlock Text="ms" Style="{StaticResource FieldLabel}" Margin="8,0,16,0"/>
                                    <Button Content="0.1초" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                            Tag="100" Click="BtnDelayPreset_Click"/>
                                    <Button Content="0.5초" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                            Tag="500" Click="BtnDelayPreset_Click"/>
                                    <Button Content="1초" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                            Tag="1000" Click="BtnDelayPreset_Click"/>
                                    <Button Content="3초" Padding="10,4" FontSize="12" Tag="3000"
                                            Click="BtnDelayPreset_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ④ 실행 설정 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="0,10,0,4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="④ 반복 횟수와 속도"/>
                                <StackPanel Orientation="Horizontal">
                                <TextBlock Text="전체 반복" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRepeat" Width="62" TextChanged="Repeat_TextChanged"/>
                                <TextBlock Text="회" Style="{StaticResource FieldLabel}" Margin="8,0,22,0"/>

                                <TextBlock Text="동작 사이 간격" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtGap" Width="72" TextChanged="Gap_TextChanged"/>
                                <TextBlock Text="ms" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>

                                <Button x:Name="BtnTest" Content="▶  3초 뒤 테스트 실행" Margin="26,0,0,0"
                                        Style="{StaticResource AccentButton}" Click="BtnTest_Click"
                                        ToolTip="3초 안에 대상 창을 클릭해 활성화하세요. 실행 중에는 중단 키로 멈출 수 있습니다"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ⑤ 예약 실행 -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" Margin="0,10,0,4"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Text="⑤ 예약 실행 — 키를 누르지 않아도 지정한 시각에 실행합니다"/>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkSchedule" Content="예약 사용" VerticalAlignment="Center"
                                              Click="ChkSchedule_Click"/>
                                    <TextBlock Text="시각" Style="{StaticResource FieldLabel}" Margin="20,0,8,0"/>
                                    <TextBox x:Name="TxtScheduleTime" Width="104" FontFamily="Consolas"
                                             TextChanged="ScheduleTime_TextChanged"
                                             ToolTip="HH:mm:ss 형식 (예: 10:10:09)"/>
                                    <Button Content="지금 시각" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                            Click="BtnScheduleNow_Click" ToolTip="현재 시각 + 1분을 넣습니다"/>
                                    <ComboBox x:Name="CmbScheduleMode" Width="112" Margin="14,0,0,0"
                                              SelectionChanged="CmbScheduleMode_SelectionChanged">
                                        <ComboBoxItem Content="매일 반복"/>
                                        <ComboBoxItem Content="한 번만"/>
                                    </ComboBox>
                                    <TextBlock x:Name="TxtNextRun" Style="{StaticResource FieldLabel}"
                                               Margin="18,0,0,0" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ══════════ 상태바 ══════════ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <Grid>
                <TextBlock x:Name="TxtLog" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           Text="준비됨"/>
                <TextBlock x:Name="TxtHint" FontSize="11.5" HorizontalAlignment="Right"
                           Foreground="{StaticResource TextSecondary}"
                           Text="설정은 자동 저장됩니다"/>
            </Grid>
        </Border>
    </Grid>
</Window>
