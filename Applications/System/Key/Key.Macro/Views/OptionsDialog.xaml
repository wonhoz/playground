<Window x:Class="KeyMacro.Views.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="전체 설정" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1B1B22" Foreground="#E0E0E0" ShowInTaskbar="False"
        FontFamily="Segoe UI, Malgun Gothic">
    <StackPanel Margin="22,18,22,18">

        <TextBlock Text="실행 중단 키" FontSize="14" FontWeight="Bold" Foreground="#4DD0E1"/>
        <TextBlock Foreground="#9A9AB0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="반복이 오래 돌거나 매크로가 의도와 다르게 움직일 때, 이 키를 누르면 실행 중인 동작과 대기 중인 실행이 모두 취소됩니다."/>

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Border Background="#1A1A22" CornerRadius="8" Padding="18,10" MinWidth="210"
                    BorderBrush="#4DD0E1" BorderThickness="2">
                <TextBlock x:Name="TxtAbortKey" Text="Ctrl + Alt + F12" FontFamily="Consolas"
                           FontSize="17" FontWeight="Bold" Foreground="#4DD0E1"
                           HorizontalAlignment="Center"/>
            </Border>
            <Button Content="키 지정" Margin="10,0,0,0" VerticalAlignment="Stretch" Click="BtnSetKey_Click"/>
            <Button Content="기본값" Margin="8,0,0,0" VerticalAlignment="Stretch" Click="BtnDefault_Click"
                    ToolTip="Ctrl + Alt + F12 로 되돌립니다"/>
        </StackPanel>

        <CheckBox x:Name="ChkEsc" Margin="0,16,0,0" Content="Esc 키로도 중단"/>
        <TextBlock Foreground="#888888" FontSize="11.5" Margin="25,5,0,0" TextWrapping="Wrap"
                   Text="Esc 를 매크로 트리거나 동작으로 쓰려면 꺼 두세요."/>

        <Border Height="1" Background="#37374A" Margin="0,20,0,18"/>

        <TextBlock Text="시간 동기화" FontSize="14" FontWeight="Bold" Foreground="#4DD0E1"/>
        <TextBlock Foreground="#9A9AB0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="예약 실행을 초 단위로 맞추려면 PC 시계를 기준 사이트에 동기화하세요."/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="기준 사이트" Foreground="#888888" FontSize="12" VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <TextBox x:Name="TxtUrl" Width="250" VerticalContentAlignment="Center"/>
            <Button Content="🕒  열기" Margin="8,0,0,0" Click="BtnTimeSync_Click"/>
        </StackPanel>

        <Border Height="1" Background="#37374A" Margin="0,20,0,14"/>

        <TextBlock Text="예약 실행은 각 매크로의 ⑤ 예약 실행 영역에서 켤 수 있습니다."
                   Foreground="#888888" FontSize="11.5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Content="확인" Style="{StaticResource AccentButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
