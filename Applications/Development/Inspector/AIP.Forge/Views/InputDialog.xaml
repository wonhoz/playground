<Window x:Class="AIPForge.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIP.Forge" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimary}" ShowInTaskbar="False">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="TxtPrompt" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox x:Name="TxtValue" FontFamily="{StaticResource MonoFont}"/>
        <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
            <Button Content="확인" IsDefault="True" MinWidth="76" Style="{StaticResource AccentButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
