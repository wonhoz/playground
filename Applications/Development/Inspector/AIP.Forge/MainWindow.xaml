<Window x:Class="AIPForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIP.Forge" Width="1400" Height="880" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        Closing="Window_Closing" Activated="Window_Activated">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.SaveAs}"/>
        <KeyBinding Key="F" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.Find}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="CmdOpen_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="CmdSave_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="CmdSaveAs_Executed"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Find}" Executed="CmdFind_Executed"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="RowLogSplitter" Height="0"/>
            <RowDefinition x:Name="RowLog" Height="0"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ 도구 모음 ══════════════════════════════════════════════ -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="12,9">
            <DockPanel LastChildFill="True">
                <WrapPanel DockPanel.Dock="Left" MaxWidth="1180" HorizontalAlignment="Left">
                    <Button Content="열기" Style="{StaticResource ToolButton}" Click="BtnOpen_Click"
                            ToolTip="AIP 파일 열기 (Ctrl+O)"/>
                    <Button x:Name="BtnSave" Content="저장" Style="{StaticResource ToolButton}" Click="BtnSave_Click"
                            ToolTip="저장 (Ctrl+S) — 덮어쓰기 전 원본을 로컬 백업 폴더에 보관"/>
                    <Button x:Name="BtnSaveAs" Content="다른 이름으로 저장" Style="{StaticResource ToolButton}" Click="BtnSaveAs_Click"
                            ToolTip="다른 이름으로 저장 (Ctrl+Shift+S)"/>
                    <Button x:Name="BtnDiff" Content="변경 사항 보기" Style="{StaticResource ToolButton}" Click="BtnDiff_Click"
                            ToolTip="디스크의 원본과 현재 편집 내용을 줄 단위로 비교"/>
                    <Button x:Name="BtnReload" Content="다시 불러오기" Style="{StaticResource ToolButton}" Click="BtnReload_Click"
                            ToolTip="편집 내용을 버리고 디스크에서 다시 읽기"/>
                    <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2,12,2"/>
                    <Button x:Name="BtnVersion" Content="버전 변경" Style="{StaticResource ToolButton}" Click="BtnVersion_Click"
                            ToolTip="ProductVersion 변경 (+ ProductCode 새로 발급)"/>
                    <Border Width="1" Background="{StaticResource LineBrush}" Margin="6,2,12,2"/>
                    <ComboBox x:Name="CmbBuild" Width="150" Margin="0,0,6,0" ToolTip="빌드할 구성 (BuildComponent)"/>
                    <Button x:Name="BtnBuild" Content="▶ 빌드" Style="{StaticResource ToolAccentButton}" Click="BtnBuild_Click"
                            ToolTip="AdvancedInstaller.com /build — 변경된 부분만 빌드"/>
                    <Button x:Name="BtnRebuild" Content="리빌드" Style="{StaticResource ToolButton}" Click="BtnRebuild_Click"
                            ToolTip="AdvancedInstaller.com /rebuild — 전체 다시 빌드"/>
                    <CheckBox x:Name="ChkSyncBeforeBuild" Content="빌드 전 폴더 동기화" Margin="4,0,12,0" VerticalAlignment="Center"
                              FontSize="12.5" Checked="ChkSyncBeforeBuild_Changed" Unchecked="ChkSyncBeforeBuild_Changed"
                              ToolTip="빌드 전에 /RefreshSync 실행 — 동기화 폴더(원본)에 새로 추가·삭제된 파일을 프로젝트에 반영"/>
                    <Button x:Name="BtnOpenAi" Content="Advanced Installer에서 열기" Style="{StaticResource ToolButton}" Click="BtnOpenAi_Click"/>
                </WrapPanel>
                <DockPanel VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border x:Name="BdgDirty" DockPanel.Dock="Right" Background="{StaticResource AccentSoft}" CornerRadius="4"
                            Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="수정됨" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                    </Border>
                    <TextBlock x:Name="TxtFilePath" Foreground="{StaticResource TextSecondary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ══ 본문 ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColNav" Width="300" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 폴더 목록 + 검색 + 탐색 트리 -->
            <Grid Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="PnlFolder" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Padding="10,10,10,8" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="2,0,0,6">
                            <CheckBox x:Name="ChkAllFiles" DockPanel.Dock="Left" Margin="4,0,8,0" VerticalAlignment="Center"
                                      Click="ChkAllFiles_Click" ToolTip="전체 선택 / 해제"/>
                            <TextBlock x:Name="TxtFolderTitle" Text="같은 폴더의 AIP" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ListBox x:Name="LstFiles" MaxHeight="230" SelectionChanged="LstFiles_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" Margin="2,0,8,0"
                                                  VerticalAlignment="Center" Click="FileCheck_Click"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       FontWeight="{Binding Weight}"/>
                                            <TextBlock Text="{Binding ProductName}" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="BtnBatchVersion" Content="선택 버전 일괄 변경" Style="{StaticResource ToolButton}"
                                    Margin="0,0,6,6" Click="BtnBatchVersion_Click"/>
                            <Button x:Name="BtnBatchBuild" Content="선택 일괄 빌드" Style="{StaticResource ToolButton}"
                                    Margin="0,0,6,6" Click="BtnBatchBuild_Click"/>
                            <Button x:Name="BtnCompareTwo" Content="선택 2개 비교" Style="{StaticResource ToolButton}"
                                    Margin="0,0,6,6" Click="BtnCompareTwo_Click" ToolTip="체크한 두 파일의 XML을 줄 단위로 비교"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Padding="10,10,10,6">
                    <TextBox x:Name="TxtGlobalSearch" KeyDown="TxtGlobalSearch_KeyDown"
                             ToolTip="모든 테이블의 값에서 찾기 (Enter, Ctrl+Shift+F)"/>
                </Border>
                <TextBlock Grid.Row="1" Text="전체 검색 (Enter)" Foreground="#5E5E74" FontSize="12.5"
                           Margin="21,0,0,2" VerticalAlignment="Center" IsHitTestVisible="False"
                           x:Name="TxtSearchHint"/>

                <TreeView x:Name="NavTree" Grid.Row="2" Margin="6,0,4,8"
                          SelectedItemChanged="NavTree_SelectedItemChanged"/>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          DragCompleted="NavSplitter_DragCompleted"/>

            <!-- 오른쪽: 내용 패널 (한 번에 하나만 표시) -->
            <Grid Grid.Column="2" Margin="0,0,0,0">

                <!-- 시작 화면 -->
                <ScrollViewer x:Name="PnlWelcome" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="48,44,48,24" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="AIP.Forge" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="Advanced Installer 프로젝트(.aip) 뷰어 · 편집기 · 빌더" FontSize="15" Margin="0,6,0,0"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="21"
                                   Text="파일을 열거나 이 창에 끌어다 놓으세요. 속성·파일·바로가기·서비스 등 모든 테이블을 표로 보고 고칠 수 있고, 원본 형식 그대로(바이트 단위) 저장됩니다. 설치된 Advanced Installer CLI로 바로 빌드할 수 있으며, 같은 폴더의 여러 AIP를 한 번에 버전 변경·빌드할 수 있습니다."/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="AIP 파일 열기" Style="{StaticResource AccentButton}" Click="BtnOpen_Click" Padding="18,8"/>
                        </StackPanel>
                        <TextBlock Text="최근 파일" Style="{StaticResource SectionTitle}" Margin="0,34,0,8"/>
                        <TextBlock x:Name="TxtNoRecent" Text="아직 없습니다." Foreground="{StaticResource TextSecondary}" FontSize="12.5"/>
                        <ItemsControl x:Name="LstRecent"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 개요 -->
                <ScrollViewer x:Name="PnlOverview" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="22,18,22,18" MaxWidth="1100" HorizontalAlignment="Left" MinWidth="640">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="제품 정보" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="제품 버전" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TxtOvVersion" FontSize="22" FontWeight="SemiBold"
                                                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="버전 변경" Margin="14,0,0,0" Click="BtnVersion_Click" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="제품명" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtOvProductName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Tag="ProductName"
                                             LostKeyboardFocus="OvField_LostFocus" KeyDown="OvField_KeyDown"/>

                                    <TextBlock Grid.Row="2" Text="제어판 표시 이름" Style="{StaticResource FieldLabel}"
                                               ToolTip="AI_PRODUCTNAME_ARP — 프로그램 추가/제거에 표시되는 이름"/>
                                    <TextBox x:Name="TxtOvArpName" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Tag="AI_PRODUCTNAME_ARP"
                                             LostKeyboardFocus="OvField_LostFocus" KeyDown="OvField_KeyDown"/>

                                    <TextBlock Grid.Row="3" Text="제조사" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtOvManufacturer" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Tag="Manufacturer"
                                             LostKeyboardFocus="OvField_LostFocus" KeyDown="OvField_KeyDown"/>

                                    <TextBlock Grid.Row="4" Text="UpgradeCode" Style="{StaticResource FieldLabel}"
                                               ToolTip="제품군 식별자 — 버전이 바뀌어도 유지되어야 합니다"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,10">
                                        <TextBlock x:Name="TxtOvUpgradeCode" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="복사" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                Tag="UpgradeCode" Click="BtnCopyCode_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Text="ProductCode" Style="{StaticResource FieldLabel}"
                                               ToolTip="버전마다 달라야 하는 제품 식별자"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,10">
                                        <TextBlock x:Name="TxtOvProductCode" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="복사" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                Tag="ProductCode" Click="BtnCopyCode_Click"/>
                                        <Button Content="새로 발급" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                Click="BtnNewProductCode_Click"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="6" Text="프로젝트" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtOvProject" Grid.Row="6" Grid.Column="1" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="빌드 출력" Style="{StaticResource SectionTitle}"/>
                                <StackPanel x:Name="OvBuilds"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="폴더 동기화 (원본 → 설치 폴더)" Style="{StaticResource SectionTitle}"/>
                                <StackPanel x:Name="OvSync"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="구성 한눈에 보기" Style="{StaticResource SectionTitle}"/>
                                <WrapPanel x:Name="OvStats"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="BtnValidate" DockPanel.Dock="Right" Content="빌드 전 점검 실행"
                                            Click="BtnValidate_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="빌드 전 점검" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"
                                                   Text="원본 파일 누락 여부와, 동기화 폴더에 프로젝트에 아직 반영되지 않은 새 파일이 있는지 확인합니다."/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="OvValidation" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 테이블 편집 -->
                <Grid x:Name="PnlTable" Visibility="Collapsed" Margin="18,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtTableTitle" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTableCount" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,2"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTableDesc" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,12,0,8">
                        <TextBox x:Name="TxtTableFilter" DockPanel.Dock="Left" Width="260" Margin="0,0,10,0"
                                 TextChanged="TxtTableFilter_TextChanged" ToolTip="이 테이블에서 걸러 보기 (모든 열 대상)"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="행 추가" Style="{StaticResource ToolButton}" Click="BtnRowAdd_Click"
                                    ToolTip="맨 아래에 빈 행 추가"/>
                            <Button Content="선택 행 복제" Style="{StaticResource ToolButton}" Click="BtnRowDuplicate_Click"
                                    ToolTip="선택한 행을 복사해 바로 아래에 추가 (키 값은 자동으로 고유하게)"/>
                            <Button Content="선택 행 삭제" Style="{StaticResource ToolButton}" Click="BtnRowDelete_Click"
                                    Foreground="{StaticResource DangerBrush}"/>
                            <Button Content="열(속성) 추가" Style="{StaticResource ToolButton}" Click="BtnColumnAdd_Click"/>
                            <Button Content="선택 셀 속성 제거" Style="{StaticResource ToolButton}" Click="BtnCellClear_Click"
                                    ToolTip="값을 비우는 것이 아니라 속성 자체를 ROW에서 제거"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="이 테이블에서 걸러 보기" Foreground="#5E5E74" FontSize="12.5"
                               Margin="11,12,0,8" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                               x:Name="TxtFilterHint"/>
                    <DataGrid x:Name="TableGrid" Grid.Row="2" CellEditEnding="Grid_CellEditEnding" PreviewKeyDown="Grid_PreviewKeyDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="선택 행 복제" Click="BtnRowDuplicate_Click"/>
                                <MenuItem Header="선택 행 삭제" Click="BtnRowDelete_Click" InputGestureText="Del"/>
                                <Separator/>
                                <MenuItem Header="선택 셀 속성 제거" Click="BtnCellClear_Click"/>
                                <MenuItem Header="셀 값 복사" Click="MnuCopyCell_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="원본 파일 위치 열기" Click="MnuOpenSource_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock x:Name="TxtTableExtra" Grid.Row="3" Foreground="{StaticResource TextSecondary}" FontSize="12"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>

                <!-- XML 원문 -->
                <Grid x:Name="PnlRaw" Visibility="Collapsed" Margin="18,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="XML 원문" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="BtnRawApply" Content="편집 내용 적용" Style="{StaticResource ToolAccentButton}"
                                    Click="BtnRawApply_Click" ToolTip="XML을 다시 해석해 표 편집 화면에 반영"/>
                            <Button Content="편집 취소" Style="{StaticResource ToolButton}" Click="BtnRawRevert_Click"/>
                            <TextBox x:Name="TxtRawFind" Width="220" Margin="10,0,6,0" KeyDown="TxtRawFind_KeyDown"
                                     ToolTip="찾기 — Enter: 다음, Shift+Enter: 이전"/>
                            <TextBlock x:Name="TxtRawStatus" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBox x:Name="TxtRaw" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             IsInactiveSelectionHighlightEnabled="True"
                             TextChanged="TxtRaw_TextChanged"/>
                </Grid>

                <!-- 검색 결과 -->
                <Grid x:Name="PnlSearch" Visibility="Collapsed" Margin="18,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock x:Name="TxtSearchTitle" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="행을 두 번 클릭하면 해당 테이블의 셀로 이동합니다." FontSize="12.5"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="GridSearch" Grid.Row="1" IsReadOnly="True" SelectionUnit="FullRow" SelectionMode="Single"
                              MouseDoubleClick="GridSearch_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="테이블" Binding="{Binding Table}" Width="180"/>
                            <DataGridTextColumn Header="행 키" Binding="{Binding Key}" Width="240"/>
                            <DataGridTextColumn Header="속성" Binding="{Binding Attribute}" Width="140"/>
                            <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 폴더 비교 -->
                <Grid x:Name="PnlCompare" Visibility="Collapsed" Margin="18,14,18,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="폴더 비교" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="같은 폴더의 AIP들의 핵심 설정을 나란히 봅니다. 값이 서로 다른 항목은 '차이' 열에 표시됩니다."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="GridCompare" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"
                              AutoGeneratingColumn="GridCompare_AutoGeneratingColumn"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══ 빌드 로그 ══════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" DragCompleted="LogSplitter_DragCompleted"
                      Background="{StaticResource LineBrush}"/>
        <Grid Grid.Row="3" Background="#15151B">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="12,6,10,6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnCancelBuild" Content="중지" Style="{StaticResource ToolButton}" Click="BtnCancelBuild_Click"
                            Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                    <Button x:Name="BtnOpenOutput" Content="출력 폴더 열기" Style="{StaticResource ToolButton}" Click="BtnOpenOutput_Click"
                            IsEnabled="False"/>
                    <Button Content="로그 복사" Style="{StaticResource ToolButton}" Click="BtnCopyLog_Click"/>
                    <Button Content="지우기" Style="{StaticResource ToolButton}" Click="BtnClearLog_Click"/>
                    <Button Content="닫기" Style="{StaticResource ToolButton}" Click="BtnCloseLog_Click" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="빌드 로그" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBuildState" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="LstLog" Grid.Row="1" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Margin="6,0,6,6" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter Margin="6,0"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- ══ 상태 표시줄 ════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnShowLog" Content="빌드 로그 보기" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                            Click="BtnShowLog_Click" FontSize="12"/>
                    <Button x:Name="BtnAiPath" Style="{StaticResource LinkButton}" Click="BtnAiPath_Click" FontSize="12"
                            ToolTip="클릭해서 AdvancedInstaller.com 위치 지정"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
