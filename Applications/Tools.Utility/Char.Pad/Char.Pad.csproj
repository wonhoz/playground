<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Char.Pad</AssemblyName>
    <RootNamespace>CharPad</RootNamespace>
    <Version>2.8.0</Version>
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <StartupObject>CharPad.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <!-- GHSA-2m69-gcr7-jv3q: Microsoft.Data.Sqlite transitive SQLitePCLRaw <= 2.1.11 -> pin patched version -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" Condition="Exists('Resources\app.ico')" />
    <EmbeddedResource Include="Resources\app.ico" LogicalName="app.ico" Condition="Exists('Resources\app.ico')" />
  </ItemGroup>
</Project>
