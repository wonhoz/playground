<Window x:Class="AudioCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:AudioCast.Models"
        Title="Audio.Cast"
        Width="600" Height="780"
        MinWidth="560" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">

  <Window.Resources>
    <!-- 섹션 라벨 -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- 단축키 배지 -->
    <Style x:Key="KeyBadge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,10,6"/>
    </Style>

    <!-- 변환 목록 항목 -->
    <DataTemplate x:Key="JobTemplate" DataType="{x:Type m:FileJob}">
      <Border x:Name="Row"
              Background="Transparent"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="10,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Icon"
                     Text="•"
                     FontSize="13"
                     Foreground="{StaticResource SubTextBrush}"
                     VerticalAlignment="Top"
                     Margin="0,1,0,0"/>
          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="{Binding FileName}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="12.5"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SourcePath}"/>
            <TextBlock x:Name="Detail"
                       Text="{Binding Detail}"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Detail}"
                       Margin="0,2,0,0"/>
            <ProgressBar x:Name="Bar"
                         Height="3"
                         Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay}"
                         Visibility="Collapsed"
                         Margin="0,5,0,0"/>
          </StackPanel>
          <TextBlock x:Name="State"
                     Grid.Column="2"
                     Text="{Binding StatusText}"
                     Foreground="{StaticResource SubTextBrush}"
                     FontSize="11.5"
                     FontFamily="Consolas"
                     VerticalAlignment="Top"
                     Margin="0,1,0,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Running}">
          <Setter TargetName="Icon"  Property="Text" Value="▶"/>
          <Setter TargetName="Icon"  Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="State" Property="Foreground" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="Bar"   Property="Visibility" Value="Visible"/>
          <Setter TargetName="Row"   Property="Background" Value="{StaticResource Surface2Brush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Done}">
          <Setter TargetName="Icon"  Property="Text" Value="✔"/>
          <Setter TargetName="Icon"  Property="Foreground" Value="{StaticResource SuccessBrush}"/>
          <Setter TargetName="State" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Copied}">
          <Setter TargetName="Icon"  Property="Text" Value="✔"/>
          <Setter TargetName="Icon"  Property="Foreground" Value="{StaticResource InfoBrush}"/>
          <Setter TargetName="State" Property="Foreground" Value="{StaticResource InfoBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Skipped}">
          <Setter TargetName="Icon"  Property="Text" Value="↷"/>
          <Setter TargetName="Icon"  Property="Foreground" Value="{StaticResource WarnBrush}"/>
          <Setter TargetName="State" Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Failed}">
          <Setter TargetName="Icon"   Property="Text" Value="✖"/>
          <Setter TargetName="Icon"   Property="Foreground" Value="{StaticResource DangerBrush}"/>
          <Setter TargetName="State"  Property="Foreground" Value="{StaticResource DangerBrush}"/>
          <Setter TargetName="Detail" Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Detail}" Value="">
          <Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="{x:Static m:JobStatus.Cancelled}">
          <Setter TargetName="Icon"  Property="Text" Value="■"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- 헤더 -->
      <RowDefinition Height="Auto"/>   <!-- 포맷 선택 -->
      <RowDefinition Height="Auto"/>   <!-- 옵션 -->
      <RowDefinition Height="Auto"/>   <!-- 저장 위치 -->
      <RowDefinition Height="Auto"/>   <!-- FFmpeg 안내 -->
      <RowDefinition Height="*"/>      <!-- 드롭 존 / 목록 -->
      <RowDefinition Height="Auto"/>   <!-- 진행 상황 -->
      <RowDefinition Height="Auto"/>   <!-- 상태 표시줄 -->
    </Grid.RowDefinitions>

    <!-- ── 헤더 ── -->
    <Border Grid.Row="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🎵"
                     FontSize="22"
                     Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>
          <StackPanel>
            <TextBlock Text="Audio.Cast"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="18"
                       FontWeight="SemiBold"/>
            <TextBlock Text="오디오 포맷 일괄 변환기"
                       Foreground="{StaticResource SubTextBrush}"
                       FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <Button x:Name="BtnHelp"
                Content="?"
                Style="{StaticResource DarkButton}"
                Width="28" Height="28"
                Padding="0"
                FontSize="14"
                FontWeight="SemiBold"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ToolTip="사용법 보기 (F1)"
                Click="BtnHelp_Click"/>
        <Popup x:Name="HelpPopup"
               PlacementTarget="{Binding ElementName=BtnHelp}"
               Placement="Bottom"
               HorizontalOffset="-300"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
          <Border Background="{StaticResource Surface2Brush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="18,14"
                  Width="330"
                  Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="사용법"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Margin="0,0,0,10"/>
              <TextBlock Foreground="{StaticResource TextBrush}"
                         FontSize="12"
                         LineHeight="20"
                         TextWrapping="Wrap">
                <Run Text="① 출력 포맷과 품질을 고릅니다 (예: MP3 · 128 kbps)."/>
                <LineBreak/>
                <Run Text="② 저장 위치를 지정합니다."/>
                <LineBreak/>
                <Run Text="③ 파일이나 폴더를 드래그&amp;드롭하면 즉시 일괄 변환됩니다."/>
                <LineBreak/>
                <Run Text="   폴더는 하위 폴더까지 모두 수집합니다."/>
              </TextBlock>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10"/>
              <TextBlock Text="음질 보호"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Margin="0,0,0,8"/>
              <TextBlock Foreground="{StaticResource SubTextBrush}"
                         FontSize="11.5"
                         LineHeight="18"
                         TextWrapping="Wrap">
                <Run Text="• 같은 코덱이고 원본 비트레이트가 목표 이하이면 재인코딩 없이 그대로 복사합니다."/>
                <LineBreak/>
                <Run Text="• 손실 원본(MP3 등)은 원본보다 높은 비트레이트로 올리지 않습니다 — 음질은 그대로, 용량만 커지기 때문입니다."/>
                <LineBreak/>
                <Run Text="• 무손실 출력(FLAC·WAV·ALAC)은 원본의 24bit·고해상도를 그대로 유지합니다."/>
              </TextBlock>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10"/>
              <TextBlock Text="단축키"
                         Foreground="{StaticResource AccentBrush}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource KeyBadge}">
                  <TextBlock Text="Ctrl+O" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11"/>
                </Border>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="파일 선택해서 변환" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Style="{StaticResource KeyBadge}">
                  <TextBlock Text="Esc" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11"/>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="변환 취소" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,6"/>
                <Border Grid.Row="2" Style="{StaticResource KeyBadge}" Margin="0,0,10,0">
                  <TextBlock Text="F1" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="11"/>
                </Border>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="이 도움말 표시" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center"/>
              </Grid>
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,10"/>
              <TextBlock Foreground="{StaticResource SubTextBrush}"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Text="변환 엔진: FFmpeg (ffmpeg.exe · ffprobe.exe)"/>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Border>

    <!-- ── 포맷 선택 ── -->
    <Border Grid.Row="1"
            Padding="20,14,20,12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1.15*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="입력 파일" Style="{StaticResource SectionLabel}"/>
            <ComboBox x:Name="CbInput"
                      ToolTip="드롭한 파일·폴더 중 어떤 포맷을 변환할지 선택합니다"/>
          </StackPanel>

          <TextBlock Grid.Column="1"
                     Text="→"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="20"
                     VerticalAlignment="Bottom"
                     Margin="12,0,12,4"/>

          <StackPanel Grid.Column="2">
            <TextBlock Text="출력 포맷" Style="{StaticResource SectionLabel}"/>
            <ComboBox x:Name="CbOutput" SelectionChanged="CbOutput_SelectionChanged"/>
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Text="품질" Style="{StaticResource SectionLabel}"/>
            <ComboBox x:Name="CbQuality" SelectionChanged="CbQuality_SelectionChanged"/>
          </StackPanel>
        </Grid>

        <!-- 선택한 포맷 설명 -->
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="6"
                Padding="10,7"
                Margin="0,10,0,0">
          <StackPanel>
            <TextBlock x:Name="TbFormatHint"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="11.5"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="TbLossyWarn"
                       Foreground="{StaticResource WarnBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"
                       Text="⚠ MP3·AAC 같은 손실 원본을 다시 손실 포맷으로 변환하면 음질이 조금씩 더 깎입니다."/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ── 옵션 ── -->
    <Border Grid.Row="2"
            Padding="20,12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <CheckBox x:Name="ChkSmart"
                    Content="음질 보호 (불필요한 재인코딩·비트레이트 업스케일 방지)"
                    IsChecked="True"
                    Margin="0,0,0,8"
                    ToolTip="같은 코덱·낮은 비트레이트 원본은 재인코딩 없이 복사하고, 손실 원본보다 높은 비트레이트로는 올리지 않습니다"/>
          <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ChkTags"
                      Content="태그·앨범아트 유지"
                      IsChecked="True"
                      Margin="0,0,18,0"
                      ToolTip="제목·아티스트·앨범 등 태그와 앨범아트를 복사합니다 (앨범아트: MP3·FLAC·M4A만 지원)"/>
            <CheckBox x:Name="ChkOverwrite"
                      Content="같은 이름 파일 덮어쓰기"
                      ToolTip="해제 시 '이름 (1).mp3'처럼 번호를 붙여 저장합니다. 원본 파일은 어떤 경우에도 덮어쓰지 않습니다"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="동시 변환" Style="{StaticResource SectionLabel}"/>
          <ComboBox x:Name="CbParallel" Width="90"
                    ToolTip="한 번에 변환할 파일 수 — 높을수록 빠르지만 CPU 사용량이 늘어납니다"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── 저장 위치 ── -->
    <Border Grid.Row="3"
            Padding="20,12"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="저장 위치" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <RadioButton x:Name="RbCustomDir"
                       Content="지정 폴더"
                       GroupName="OutDir"
                       IsChecked="True"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Checked="OutputMode_Changed"/>
          <TextBox x:Name="TbOutputDir" Grid.Column="1"/>
          <Button x:Name="BtnBrowse"
                  Grid.Column="2"
                  Content="찾아보기…"
                  Style="{StaticResource DarkButton}"
                  Height="30"
                  Margin="6,0,0,0"
                  Click="BtnBrowse_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="RbSourceDir"
                       Content="원본과 같은 폴더"
                       GroupName="OutDir"
                       Margin="0,0,24,0"
                       Checked="OutputMode_Changed"/>
          <CheckBox x:Name="ChkStructure"
                    Content="폴더 드롭 시 하위 폴더 구조 유지"
                    IsChecked="True"
                    ToolTip="'Album' 폴더를 드롭하면 저장 위치\Album\… 구조 그대로 저장합니다"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── FFmpeg 미설치 안내 ── -->
    <Border x:Name="FfmpegPanel"
            Grid.Row="4"
            Visibility="Collapsed"
            Margin="20,12,20,0"
            Padding="14,10"
            Background="{StaticResource AccentDimBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <StackPanel>
        <TextBlock x:Name="TbFfmpegStatus"
                   Text="FFmpeg를 찾을 수 없습니다 — 변환에 필요합니다"
                   Foreground="{StaticResource TextBrush}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="TbFfmpegLog"
                   Foreground="{StaticResource SubTextBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,4,0,0"
                   Text="winget으로 자동 설치하거나 ffmpeg.exe 위치를 직접 지정하세요."/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BtnInstallFfmpeg"
                  Content="자동 설치 (winget)"
                  Style="{StaticResource AccentButton}"
                  Margin="0,0,6,0"
                  Click="BtnInstallFfmpeg_Click"/>
          <Button x:Name="BtnPickFfmpeg"
                  Content="ffmpeg.exe 지정…"
                  Style="{StaticResource DarkButton}"
                  Margin="0,0,6,0"
                  Click="BtnPickFfmpeg_Click"/>
          <Button x:Name="BtnRecheckFfmpeg"
                  Content="다시 찾기"
                  Style="{StaticResource DarkButton}"
                  Click="BtnRecheckFfmpeg_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── 드롭 존 ── -->
    <Border Grid.Row="5"
            Margin="20,14"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="10"
            BorderThickness="1.5">
      <Border.BorderBrush>
        <SolidColorBrush x:Name="DropBorderBrush" Color="#3A3A48"/>
      </Border.BorderBrush>

      <Grid>
        <!-- 초기 힌트 -->
        <StackPanel x:Name="DropHint"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <TextBlock Text="🎧"
                     FontSize="44"
                     Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,12"/>
          <TextBlock x:Name="TbDropTitle"
                     Text="오디오 파일 또는 폴더를 여기에 드롭"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="15"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,6"/>
          <TextBlock Text="MP3 · FLAC · WAV · M4A · AAC · OGG · OPUS · WMA · AIFF · APE"
                     Foreground="{StaticResource SubTextBrush}"
                     FontSize="11.5"
                     HorizontalAlignment="Center"/>
          <Button Content="파일 선택…"
                  Style="{StaticResource DarkButton}"
                  HorizontalAlignment="Center"
                  Margin="0,14,0,0"
                  Click="BtnPickFiles_Click"/>
        </StackPanel>

        <!-- 변환 목록 -->
        <Grid x:Name="JobPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="12,8">
            <Grid>
              <TextBlock x:Name="TbJobSummary"
                         Foreground="{StaticResource TextBrush}"
                         FontSize="12"
                         VerticalAlignment="Center"/>
              <Button x:Name="BtnClearList"
                      Content="목록 지우기"
                      Style="{StaticResource LinkButton}"
                      HorizontalAlignment="Right"
                      Click="BtnClearList_Click"/>
            </Grid>
          </Border>
          <ListBox x:Name="LbJobs"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemTemplate="{StaticResource JobTemplate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
        </Grid>
      </Grid>
    </Border>

    <!-- ── 전체 진행 + 취소 ── -->
    <Grid Grid.Row="6" Margin="20,0,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ProgressBar x:Name="PBar"
                   Minimum="0" Maximum="100" Value="0"
                   Visibility="Collapsed"
                   VerticalAlignment="Center"/>
      <Button x:Name="BtnCancel"
              Grid.Column="1"
              Content="취소"
              Style="{StaticResource CancelButton}"
              Visibility="Collapsed"
              Margin="8,0,0,0"
              Click="BtnCancel_Click"/>
    </Grid>

    <!-- ── 상태 표시줄 ── -->
    <Border Grid.Row="7"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TbStatus"
                   Text="파일을 드롭하면 바로 변환을 시작합니다"
                   Foreground="{StaticResource SubTextBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Button x:Name="BtnOpenFolder"
                Grid.Column="1"
                Content="📁 저장 폴더 열기"
                Style="{StaticResource LinkButton}"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                Click="BtnOpenFolder_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
