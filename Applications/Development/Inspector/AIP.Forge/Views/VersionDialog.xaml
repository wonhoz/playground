<Window x:Class="AIPForge.Views.VersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="제품 버전 변경" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimary}" ShowInTaskbar="False">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="TxtTarget" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="새 버전" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtVersion" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="14"/>
            <Button Grid.Column="2" Content="마지막 자리 +1" Margin="8,0,0,0" Click="BtnIncrement_Click"
                    ToolTip="예: 2.4.16 → 2.4.17"/>
        </Grid>
        <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <CheckBox x:Name="ChkProductCode" Margin="0,14,0,0" IsChecked="True"
                  Content="ProductCode 새로 발급 (권장)"/>
        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="23,4,0,0"
                   Text="이전 버전을 자동으로 제거하는 Major Upgrade에 필요하며, Advanced Installer의 /SetVersion 기본 동작과 같습니다. 같은 버전을 다시 빌드할 때만 해제하세요."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="취소" IsCancel="True" MinWidth="76" Margin="0,0,8,0"/>
            <Button Content="버전 변경" IsDefault="True" MinWidth="90" Style="{StaticResource AccentButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
