<Window x:Class="AIPForge.Views.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIP.Forge" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimary}" ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,20">
        <TextBlock x:Name="TxtMessage" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
        <StackPanel x:Name="PnlButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
</Window>
